{
  "name": "my-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test",
    "db:migrate:plan": "node scripts/migrations.mjs plan",
    "db:migrate:status": "node --env-file=.env.local scripts/migrations.mjs status",
    "db:migrate:verify": "node --env-file=.env.local scripts/migrations.mjs verify",
    "db:migrate:apply": "node --env-file=.env.local scripts/migrations.mjs apply",
    "db:schema:inventory": "node --env-file=.env.local scripts/schema-inventory.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.8.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.446.0",
    "next": "14.2.35",
    "nodemailer": "^6.9.15",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.18.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.13",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
